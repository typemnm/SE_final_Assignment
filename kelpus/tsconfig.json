{
  "extends": "@react-native/typescript-types/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["es2020"],
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@features/*": ["src/features/*"],
      "@store/*": ["src/store/*"],
      "@theme/*": ["src/theme/*"],
      "@appTypes/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@api/*": ["src/api/*"],
      "@navigation/*": ["src/navigation/*"]
    }
  },
  "include": ["src/**/*", "App.tsx", "index.js"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", ".eslintrc.js"]
}
