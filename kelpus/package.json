{
  "name": "kelpus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "web": "webpack serve --config webpack.config.js --mode development",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "2.5.1",
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-native-kakao/core": "2.4.5",
    "@react-native-kakao/user": "2.4.5",
    "@react-navigation/bottom-tabs": "6.6.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "@reduxjs/toolkit": "2.3.0",
    "axios": "1.7.9",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.75.4",
    "react-native-chart-kit": "6.12.0",
    "react-native-gesture-handler": "2.21.2",
    "react-native-google-signin": "2.1.1",
    "react-native-health": "1.19.0",
    "react-native-health-connect": "3.1.0",
    "react-native-image-picker": "8.2.1",
    "react-native-keychain": "10.0.0",
    "react-native-maps": "1.20.1",
    "react-native-permissions": "5.1.0",
    "react-native-reanimated": "3.16.2",
    "react-native-safe-area-context": "4.14.0",
    "react-native-screens": "4.3.0",
    "react-native-svg": "15.8.0",
    "react-native-vector-icons": "10.2.0",
    "react-native-view-shot": "^5.1.0",
    "react-native-web": "0.21.2",
    "react-redux": "9.1.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/eslint-config": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@testing-library/react-native": "12.8.1",
    "@types/leaflet": "^1.9.8",
    "@types/react": "18.3.1",
    "@types/react-test-renderer": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-jest": "29.7.0",
    "babel-loader": "10.1.1",
    "babel-plugin-module-resolver": "5.0.2",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.37.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "5.6.7",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4",
    "url-loader": "4.1.1",
    "webpack": "5.107.2",
    "webpack-cli": "7.0.3",
    "webpack-dev-server": "5.2.4"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "^react-redux$": "<rootDir>/node_modules/react-redux/dist/cjs/index.js",
      "^immer$": "<rootDir>/node_modules/immer/dist/cjs/index.js",
      "^react-native-keychain$": "<rootDir>/src/shims/react-native-keychain.js",
      "^react-native-google-signin$": "<rootDir>/src/shims/react-native-google-signin.js",
      "^@invertase/react-native-apple-authentication$": "<rootDir>/src/shims/react-native-apple-authentication.js",
      "^@react-native-kakao/user$": "<rootDir>/src/shims/react-native-kakao-user.js",
      "^@react-native-async-storage/async-storage$": "<rootDir>/src/shims/react-native-async-storage.js",
      "^react-native-health-connect$": "<rootDir>/src/shims/react-native-health-connect.js",
      "^react-native-maps$": "<rootDir>/src/shims/react-native-maps.js",
      "^react-native-permissions$": "<rootDir>/src/shims/react-native-permissions.js",
      "^react-native-vector-icons/(.*)$": "<rootDir>/src/shims/react-native-vector-icons.js",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@store/(.*)$": "<rootDir>/src/store/$1",
      "^@theme/(.*)$": "<rootDir>/src/theme/$1",
      "^@appTypes/(.*)$": "<rootDir>/src/types/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@api/(.*)$": "<rootDir>/src/api/$1",
      "^@navigation/(.*)$": "<rootDir>/src/navigation/$1",
      "\\.(png|jpg|jpeg|gif|webp|svg)$": "<rootDir>/__mocks__/fileMock.js",
      "^react-native-image-picker$": "<rootDir>/src/shims/react-native-image-picker.js"
    },
    "setupFiles": [
      "react-native-gesture-handler/jestSetup"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
