# API 서버
API_BASE_URL=https://api.kelpus.com

# 소셜 로그인 (react-native-google-signin 설정)
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# 카카오 로그인 (@react-native-kakao/user 설정)
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here

# Google Maps (러닝 경로 지도)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# AI 식단 분석
AI_ANALYSIS_API_KEY=your_ai_analysis_api_key_here
AI_ANALYSIS_BASE_URL=https://ai.kelpus.com

# SNS 연동
INSTAGRAM_API_TOKEN=your_instagram_api_token_here

# 앱 설정
APP_ENV=development
