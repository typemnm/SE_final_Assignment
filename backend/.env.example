DATABASE_URL=postgresql+asyncpg://kelpus:kelpus_password@localhost:5432/kelpus
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Gemini 식단 이미지 분석 설정
# 실제 키는 커밋하지 말고 로컬 .env 또는 배포 secret으로만 설정하세요.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_REQUEST_TIMEOUT_SECONDS=20
GEMINI_IMAGE_MAX_BYTES=10485760

# legacy provider-generic names (현재 Gemini 분석 경로에서는 사용하지 않음)
AI_ANALYSIS_API_KEY=your-ai-api-key
AI_ANALYSIS_BASE_URL=https://api.openai.com/v1
INSTAGRAM_API_TOKEN=your-instagram-token
APPLE_APP_BUNDLE_ID=com.kelpus.app
MAP_API_KEY=your-map-api-key
FREE_PLAN_DAILY_LIMIT=3
PREMIUM_PLAN_DAILY_LIMIT=10
REDIS_URL=redis://localhost:6379/0
